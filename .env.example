# Set to true only when Supabase is configured and you want live data.
EXPO_PUBLIC_USE_SUPABASE=false
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_POSTHOG_KEY=phc_your-project-key
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Server-only secrets: never expose in apps/mobile or apps/admin-web
SUPABASE_SERVICE_ROLE_KEY=server-only
ONESIGNAL_APP_ID=server-only
ONESIGNAL_REST_API_KEY=server-only
SENTRY_AUTH_TOKEN=ci-only
EXPO_TOKEN=ci-only
