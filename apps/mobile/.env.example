# Mobile public runtime only
# Keep this false while using the local/demo data.
EXPO_PUBLIC_USE_SUPABASE=false

# Fill these only when you want the mobile app to use Supabase.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional public EAS project id for Expo Push token registration.
EXPO_PUBLIC_EAS_PROJECT_ID=
